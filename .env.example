# LPG Distribution & Consumer Management System - Environment Configuration
# Copy this file to .env and customize for your local MySQL installation

# Database Configuration (MySQL with mysql-connector-python)
DB_ENGINE=mysql
DB_NAME=lpg_manager_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to 1 to force SQLite development mode if MySQL service is not available
USE_SQLITE=0

